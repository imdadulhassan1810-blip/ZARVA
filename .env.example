# Everything here is optional for local development: the defaults just work.
# API
# "pglite" = built-in demo database (no install). For real Postgres: postgres://zarva:zarva@localhost:5432/zarva_dev
DATABASE_URL=pglite
# Required in production. Local default is fine for development.
JWT_SECRET=
PORT=4000
# OTP: "console" prints codes to the API log (dev only). "msg91" needs DLT-registered template.
OTP_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Email sign-in codes: "console" prints them in the API terminal (dev). "resend" sends real email.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=ZARVA <login@mail.zarva.in>
# Google sign-in: leave empty for the demo button (development only). See README "Google sign-in".
# List the website's client id first, then the iPhone and Android ones from the phone app builds.
GOOGLE_CLIENT_ID=
# Sign in with Apple: leave empty for the demo button (development only). See docs/sign-in-setup.md.
# The iPhone app's bundle id and the website's Services ID, comma-separated: in.zarva.app,in.zarva.web
APPLE_CLIENT_IDS=
APPLE_WEB_SERVICE_ID=
# Payments: "mock" for dev, "razorpay" for real UPI/cards
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Comma-separated vertical ids to switch on: food,shopping,events,travel,home
ENABLED_MODULES=home
# Admins are accounts in the database, not settings: create one with  pnpm admin:create <username> "<Name>"
# Locally a demo admin is made for you: username admin, password zarva-admin-dev.
# Customer website address, used in messages. Must be your real domain on a live server.
PUBLIC_WEB_URL=http://localhost:3000
# Booking updates (docs/notifications.md). "console" prints them here; live: msg91 / meta, or off.
SMS_PROVIDER=console
# event:msg91TemplateId pairs, e.g. booking_confirmed:65f0a1...,pro_assigned:65f0a2...
MSG91_SMS_TEMPLATES=
WHATSAPP_PROVIDER=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Partner payouts: "manual" (admin pays by UPI, types the UTR) or "razorpayx" (automatic, after KYC)
PAYOUT_PROVIDER=manual
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=
# Abuse limits on sign-in codes (every SMS costs money). Defaults are fine to start; raise the SMS ceiling as you grow.
CODE_LIMIT_PER_IP_PER_HOUR=20
SMS_CODE_LIMIT_PER_HOUR=500
# On a live server "Pay online" is hidden while RAZORPAY_KEY_ID is a test key (rzp_test_...). true only for a private test site.
ALLOW_TEST_PAYMENTS=false
# Encrypts partner KYC documents. Required on a live server: 32+ random characters. Never change it once set.
KYC_ENCRYPTION_KEY=
# Web
NEXT_PUBLIC_API_URL=http://localhost:4000

# ----- Customer invoices -----
# Without INVOICE_GSTIN the PDF is a "Bill / payment receipt", not a GST tax invoice.
# Set it only once ZARVA is GST-registered. Invoices already issued never change.
INVOICE_LEGAL_NAME=ZARVA
INVOICE_ADDRESS=Durgapur, West Bengal
INVOICE_STATE=West Bengal
INVOICE_GSTIN=
