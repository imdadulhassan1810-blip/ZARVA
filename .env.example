# Everything here is optional for local development: the defaults just work.
# API
# "pglite" = built-in demo database (no install). For real Postgres: postgres://zarva:zarva@localhost:5432/zarva_dev
DATABASE_URL=pglite
# Required in production. Local default is fine for development.
JWT_SECRET=
PORT=4000
# OTP: "console" prints codes to the API log (dev only). "msg91" needs DLT-registered template.
OTP_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Payments: "mock" for dev, "razorpay" for real UPI/cards
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Comma-separated vertical ids to switch on: food,shopping,events,travel,home
ENABLED_MODULES=
# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
