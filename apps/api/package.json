{
  "name": "@zarva/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "admin:create": "tsx --env-file-if-exists=../../.env src/admin/create-admin.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/modules/home/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@fastify/cors": "11.4.3",
    "@fastify/helmet": "13.2.0",
    "@zarva/brand": "workspace:*",
    "@zarva/core": "workspace:*",
    "@zarva/payments": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "jose": "5.9.6",
    "postgres": "3.4.5",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "tsx": "4.19.2",
    "vitest": "3.0.4"
  }
}
