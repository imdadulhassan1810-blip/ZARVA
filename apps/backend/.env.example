DATABASE_URL="postgresql://oneapp:oneapp@localhost:5432/oneapp?schema=public"
JWT_SECRET="change-this-to-a-long-random-string"
PORT=4000
CORS_ORIGIN="*"

# Optional: real Razorpay checkout. Leave unset to keep using the built-in mock
# "instant success" checkout — nothing breaks without these. Get test keys from
# https://dashboard.razorpay.com/app/keys (Test Mode).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
