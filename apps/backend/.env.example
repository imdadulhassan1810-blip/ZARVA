DATABASE_URL="postgresql://oneapp:oneapp@localhost:5432/oneapp?schema=public"
JWT_SECRET="change-this-to-a-long-random-string"
PORT=4000
CORS_ORIGIN="*"

# Optional: real Razorpay checkout. Leave unset to keep using the built-in mock
# "instant success" checkout — nothing breaks without these. Get test keys from
# https://dashboard.razorpay.com/app/keys (Test Mode).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: "Sign in with Google". Leave all three unset to hide the Google button on
# every client — password login/register keeps working either way. GOOGLE_CLIENT_ID (a
# "Web application" OAuth client from https://console.cloud.google.com/apis/credentials,
# with http://localhost:5173 as an authorized JavaScript origin) is enough for the web
# app and for testing on mobile via `expo start --web`. A real iOS/Android build needs
# its own native client ids too — see the README for the full mobile setup.
GOOGLE_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
