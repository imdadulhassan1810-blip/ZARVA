generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  /// Null for accounts that only ever signed in via Google — see googleId.
  passwordHash String?
  /// Set once this account has signed in with Google at least once (either created via
  /// Google, or a password account that later linked Google by using the same email).
  googleId     String?    @unique
  phone        String?
  /// "user" or "admin". Admins get read access to every user's orders plus limited
  /// management (order status, activating/deactivating accounts) via /api/admin/*.
  role         String     @default("user")
  /// Deactivated accounts can't log in. Admins can't deactivate their own account.
  isActive     Boolean    @default(true)
  /// Expo push token for this user's mobile device, if they've granted notification
  /// permission. Nullable — web users and users who haven't opted in have none.
  pushToken    String?
  createdAt    DateTime   @default(now())
  cartItems    CartItem[]
  orders       Order[]
}

model Listing {
  id           String     @id @default(cuid())
  categorySlug String
  title        String
  subtitle     String?
  imageEmoji   String
  /// Real product photo URL, set only for listings pulled in from a live provider.
  imageUrl     String?
  price        Float
  priceUnit    String
  rating       Float?
  location     String?
  tags         String[]
  meta         Json       @default("{}")
  /// Set when this row was persisted from a live external provider (e.g. "openfoodfacts")
  /// rather than our own seed data.
  source       String?
  createdAt    DateTime   @default(now())
  cartItems    CartItem[]

  @@index([categorySlug])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

model Order {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String
  status       String   @default("confirmed")
  /// "mock" | "cod" | "card" | "netbanking" | "razorpay" — how this order was (or will be) paid for.
  paymentMethod String  @default("mock")
  categorySlug String
  total        Float
  items        Json
  details      Json     @default("{}")
  createdAt    DateTime @default(now())

  @@index([userId])
}
