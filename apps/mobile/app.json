{
  "expo": {
    "name": "OneApp",
    "slug": "oneapp",
    "version": "0.1.0",
    "scheme": "oneapp",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#5B3DF6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oneapp.mobile"
    },
    "android": {
      "package": "com.oneapp.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5B3DF6"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "notification": {
      "color": "#5B3DF6"
    },
    "plugins": [
      "expo-notifications",
      "expo-font"
    ],
    "extra": {
      "apiUrl": "http://localhost:4000"
    }
  }
}
