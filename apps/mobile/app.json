{
  "expo": {
    "name": "OneApp",
    "slug": "oneapp",
    "version": "0.1.0",
    "scheme": "oneapp",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#2a5cf5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oneapp.mobile"
    },
    "android": {
      "package": "com.oneapp.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#2a5cf5"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "notification": {
      "color": "#2a5cf5"
    },
    "plugins": ["expo-notifications"],
    "extra": {
      "apiUrl": "http://localhost:4000"
    }
  }
}
