{
  "expo": {
    "name": "ZARVA",
    "slug": "zarva",
    "scheme": "zarva",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F6F5FB",
    "ios": {
      "bundleIdentifier": "in.zarva.app",
      "supportsTablet": false
    },
    "android": {
      "package": "in.zarva.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F0B24"
      }
    },
    "extra": {},
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "ZARVA Partner uses your photos to upload your ID proof.",
          "cameraPermission": "ZARVA Partner uses the camera for your ID proof and selfie."
        }
      ]
    ]
  }
}
