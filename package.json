{
  "name": "zarva",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @zarva/api --filter @zarva/web dev",
    "dev:api": "pnpm --filter @zarva/api dev",
    "dev:web": "pnpm --filter @zarva/web dev",
    "dev:mobile": "pnpm --filter @zarva/mobile start",
    "db:migrate": "pnpm --filter @zarva/api db:migrate",
    "admin:2fa": "pnpm --filter @zarva/api admin:2fa",
    "db:seed": "pnpm --filter @zarva/api db:seed --",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "@types/node": "22.10.7"
  }
}
